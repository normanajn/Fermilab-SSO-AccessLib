# Example settings file for fermi_sso_probe.
#
# Copy to .env in your working directory, or to ~/.fermi_sso.env for a
# per-user default, then restrict the permissions -- it holds a password:
#
#     cp env.example ~/.fermi_sso.env
#     chmod 600 ~/.fermi_sso.env
#
# Syntax: KEY=value, one per line. Blank lines and # comments are ignored,
# a leading "export " is stripped, and quoted values have their quotes
# removed. Quote any value containing '#', or the rest of the line is
# treated as a comment. '=' inside a value needs no quoting.
#
# Anything here is overridden by the matching environment variable, which
# is in turn overridden by a command line option.

# Fermilab services account name. Defaults to $USER if unset.
FERMI_USER=myaccount

# Password. Quote it if it contains '#' or leading/trailing spaces.
# It cannot contain ':' -- see docs/HOWTO.md.
FERMI_PASSWORD=mypassword

# URL to fetch. Defaults to the Mu2e DocDB SSO entry point. Note that
# https://mu2e-docdb.fnal.gov/ itself is unprotected and will not
# exercise the login flow.
FERMI_SSO_URL=https://mu2e-docdb.fnal.gov/cgi-bin/sso/DocumentDatabase

# Authentication method at the identity provider: password (default) or
# kerberos. Kerberos uses your kinit ticket via requests-gssapi and needs no
# FERMI_PASSWORD; install with: pip install 'requests-fermi_sso[kerberos]'
#FERMI_SSO_AUTH=password

# With FERMI_SSO_AUTH=yubikey: file holding the PIV PIN (mode 600). Without
# it openssl prompts on the terminal.
#FERMI_SSO_PIN_SOURCE=~/.fermi_sso.pin

# The rest of the YubiKey settings are only needed when the tools are not
# where fermi_sso_yubikey looks by default -- run `fermi-sso-yubikey` and it
# reports which of these it could not find. See fermi_sso_yubikey(3).
#
# OpenSSL 3 binary. Must be a real OpenSSL 3 build with engine support;
# Apple's /usr/bin/openssl is LibreSSL and will not work.
#FERMI_SSO_OPENSSL=/opt/homebrew/opt/openssl@3/bin/openssl
#
# Directory holding the pkcs11 engine (pkcs11.dylib or pkcs11.so).
#FERMI_SSO_ENGINES_DIR=/opt/homebrew/lib/engines-3
#
# PKCS#11 module for the token: libykcs11 from yubico-piv-tool, or
# opensc-pkcs11 from opensc.
#FERMI_SSO_PKCS11_MODULE=/opt/homebrew/lib/libykcs11.dylib
#
# PKCS#11 URI of the private key. The default is PIV slot 9A, which is
# object id 1 on a YubiKey.
#FERMI_SSO_PKCS11_KEY=pkcs11:id=%01;type=private
#
# pkcs11-tool, used to export the certificate from the token.
#FERMI_SSO_PKCS11_TOOL=/opt/homebrew/bin/pkcs11-tool

# Cookie jar. Loaded before the request and rewritten after a completed
# login, so later runs skip the password step. When this file exists the
# password above is optional. A browser cookies.txt export works here too.
#FERMI_SSO_COOKIE_FILE=~/.fermi_sso.cookies

# Cookie file format: netscape (default), lwp, or json. Normally detected.
#FERMI_SSO_COOKIE_FORMAT=netscape

# Identity provider hostname, used to detect a login that stalled.
#FERMI_SSO_IDP_HOST=pingprod.fnal.gov

# Set to 1 for wire-level debug logging.
#FERMI_SSO_DEBUG=0

# Read settings from this file instead of ./.env then ~/.fermi_sso.env.
# Only useful from the environment; setting it inside an env file does
# nothing, since the file has already been chosen by then.
#FERMI_SSO_ENV_FILE=~/.fermi_sso.env
